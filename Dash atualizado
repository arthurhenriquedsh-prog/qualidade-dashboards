  const LJ=['SIA','SS','TG','LEAP'];
  const C=GR.data.grow.casos.filter(c=>(c.mc==='?'||mcOk(c.mc))&&(GW.loja==='todas'||c.l===GW.loja));
  const ano=(GR.data.periodo.match(/(\d{4})/)||[0,'2026'])[1]; const meses=grMeses().filter(m=>C.some(c=>c.ab.slice(0,7)===m));
