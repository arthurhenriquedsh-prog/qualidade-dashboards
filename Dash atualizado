  for(const l of lojas) for(const [mc,M] of Object.entries(D[l]||{})){ if(!mcOk(mc)) continue; for(const m of meses){ const x=M[m]; if(!x) continue; o.n+=x.n;o.p+=x.p;o.d+=x.d;o.ss+=x.ss;o.sn+=x.sn; for(const [k,v] of Object.entries(x.a)){ const a=o.a[k]=o.a[k]||[0,0,0]; a[0]+=v[0];a[1]+=v[1];a[2]+=v[2]; } } }
  o.nps=o.n?Math.round((o.p-o.d)/o.n*1000)/10:null; o.sat=o.sn?Math.round(o.ss/o.sn*10)/10:null; return o; }
function grSomaMc(area,loja,mc,meses){ const M=((GR.data[area]||{})[loja]||{})[mc]||{}; const o={n:0,p:0,d:0,ss:0,sn:0,a:{}}; for(const m of meses){ const x=M[m]; if(!x) continue; o.n+=x.n;o.p+=x.p;o.d+=x.d;o.ss+=x.ss;o.sn+=x.sn; for(const [k,v] of Object.entries(x.a)){ const a=o.a[k]=o.a[k]||[0,0,0]; a[0]+=v[0];a[1]+=v[1];a[2]+=v[2]; } } o.nps=o.n?Math.round((o.p-o.d)/o.n*1000)/10:null; o.sat=o.sn?Math.round(o.ss/o.sn*10)/10:null; return o; }
function grLinhas(series,meses,{min=0,max=100,fmt=v=>v+'%',w=1000,h=260}={}){
  const L=50,R=20,T=16,B=30, iw=w-L-R, ih=h-T-B; const x=i=>L+iw*(meses.length<2?0.5:i/(meses.length-1)); const y=v=>T+ih*(1-(v-min)/(max-min||1));
  let g=''; for(let k=0;k<=4;k++){ const v=min+(max-min)*k/4; g+='<line x1="'+L+'" x2="'+(w-R)+'" y1="'+y(v)+'" y2="'+y(v)+'" stroke="var(--line)"/><text x="'+(L-8)+'" y="'+(y(v)+4)+'" text-anchor="end" font-size="11" fill="var(--ink-3)">'+fmt(Math.round(v))+'</text>'; }
  meses.forEach((m,i)=>{ g+='<text x="'+x(i)+'" y="'+(h-8)+'" text-anchor="middle" font-size="11" fill="var(--ink-3)">'+GR_MES[+m.slice(5)-1]+'</text>'; });
  for(const s of series){ const pts=s.v.map((v,i)=>v==null?null:[x(i),y(Math.max(min,Math.min(max,v))),v]); let d='',on=false; pts.forEach(p=>{ if(!p){on=false;return;} d+=(on?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1); on=true; });
    g+='<path d="'+d+'" fill="none" stroke="'+s.c+'" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>'+pts.filter(Boolean).map(p=>'<circle cx="'+p[0]+'" cy="'+p[1]+'" r="3.5" fill="'+s.c+'"><title>'+esc(s.n)+': '+fmt(p[2])+'</title></circle>').join(''); }
  return '<svg class="gr-svg" viewBox="0 0 '+w+' '+h+'" role="img">'+g+'</svg>'; }
function grBarras(series,meses,{w=1000,h=240}={}){
  const L=40,R=10,T=14,B=30, iw=w-L-R, ih=h-T-B; const tot=meses.map((m,i)=>series.reduce((a,s)=>a+(s.v[i]||0),0)); const mx=Math.max(1,...tot); const bw=iw/meses.length;
  let g=''; for(let k=0;k<=4;k++){ const v=Math.round(mx*k/4); const yy=T+ih*(1-k/4); g+='<line x1="'+L+'" x2="'+(w-R)+'" y1="'+yy+'" y2="'+yy+'" stroke="var(--line)"/><text x="'+(L-6)+'" y="'+(yy+4)+'" text-anchor="end" font-size="11" fill="var(--ink-3)">'+v+'</text>'; }
  meses.forEach((m,i)=>{ let acc=0; const x0=L+bw*i+bw*0.18, bwi=bw*0.64; for(const s of series){ const v=s.v[i]||0; if(!v) continue; const hh=ih*v/mx; g+='<rect x="'+x0+'" y="'+(T+ih-(acc+hh))+'" width="'+bwi+'" height="'+hh+'" fill="'+s.c+'" rx="2"><title>'+esc(s.n)+' · '+GR_MES[+m.slice(5)-1]+': '+v+'</title></rect>'; acc+=hh; }
    g+='<text x="'+(L+bw*i+bw/2)+'" y="'+(h-8)+'" text-anchor="middle" font-size="11" fill="var(--ink-3)">'+GR_MES[+m.slice(5)-1]+'</text>'+(tot[i]?'<text x="'+(L+bw*i+bw/2)+'" y="'+(T+ih-acc-5)+'" text-anchor="middle" font-size="11" font-weight="700" fill="var(--ink-2)">'+tot[i]+'</text>':''); });
  return '<svg class="gr-svg" viewBox="0 0 '+w+' '+h+'" role="img">'+g+'</svg>'; }
const grTabs=(k,ops,cur)=>'<div class="tabs2">'+ops.map(([v,l])=>'<button data-'+k+'="'+v+'" class="'+(cur===v?'on':'')+'">'+l+'</button>').join('')+'</div>';
