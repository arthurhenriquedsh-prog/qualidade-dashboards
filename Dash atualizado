  const tipos={}; C.filter(c=>c.ab.slice(0,4)===ano).forEach(c=>{ tipos[c.t]=tipos[c.t]||{}; const m=c.ab.slice(0,7); tipos[c.t][m]=(tipos[c.t][m]||0)+1; });
  const tl=Object.entries(tipos).map(([k,v])=>[k,Object.values(v).reduce((a,b)=>a+b,0),v]).sort((a,b)=>b[1]-a[1]);
  const hm='<div class="tbl-wrap gr-t gr-hm"><table><thead><tr><th>Tipo de caso</th>'+meses.map(m=>'<th class="v">'+GR_MES[+m.slice(5)-1]+'</th>').join('')+'<th class="v">Total</th></tr></thead><tbody>'+
    tl.map(([k,tot,v])=>'<tr><td>'+esc(k)+'</td>'+meses.map(m=>{ const n=v[m]||0; const mx=Math.max(...tl.flatMap(x=>Object.values(x[2]))); return '<td class="v" style="background:'+(n?'rgba(30,61,98,'+(0.08+0.5*n/mx).toFixed(2)+')':'transparent')+';color:'+(n/mx>0.55?'#fff':'var(--ink)')+'">'+(n||'')+'</td>'; }).join('')+'<td class="v"><b>'+tot+'</b></td></tr>').join('')+'</tbody></table></div>';
  const stc={}; ab.forEach(c=>{ stc[c.s||'Sem status']=(stc[c.s||'Sem status']||0)+1; });
  const lista=ab.slice().sort((a,b)=>(a.ab||'').localeCompare(b.ab||'')).map(c=>{ const dias=c.ab?Math.floor((new Date(todayISO()+'T12:00')-new Date(c.ab+'T12:00'))/864e5):null; const ua=c.ua?Math.floor((new Date(todayISO()+'T12:00')-new Date(c.ua+'T12:00'))/864e5):null;
    return '<tr><td><span class="small" style="font-weight:700;color:'+GR_COR[c.l]+'">'+c.l+'</span>'+(c.mc!=='?'?' '+marcaTag(c.mc):'')+'</td><td>'+esc(c.t)+(c.im?' <span class="ct-chip negada">imobilizado</span>':'')+(c.st==='Suspenso'?' <span class="ct-chip nao">suspenso</span>':'')+'</td><td class="v">'+fmtD(c.ab)+'<div class="small '+(dias>30?'':'muted')+'" style="'+(dias>30?'color:var(--crit-ink);font-weight:700':'')+'">'+(dias!=null?dias+' dias':'')+'</div></td><td>'+esc(c.s)+(ua!=null?'<div class="small muted">atualizado há '+ua+' dia(s)</div>':'')+'</td></tr>'; }).join('');
  return cab('Grow','Casos do Grow de SIA, SS, TG e Leapmotor: progresso mensal e o que está em aberto. Atualizado em '+GR.data.grow.atualizado+'.',grTabs('gwl',[['todas','Todas'],['SIA','SIA'],['SS','SS'],['TG','TG'],['LEAP','Leap']],GW.loja))+
   '<div class="gr-k">'+kp+'</div>'+
   '<div class="card"><h3>Casos abertos por mês</h3><p class="small muted" style="margin:0">Pela data de abertura do caso no Grow, em '+ano+'.</p><div class="gr-leg">'+ser.map(s=>'<span><i style="background:'+s.c+';height:10px;width:10px"></i>'+esc(s.n)+'</span>').join('')+'</div>'+grBarras(ser,meses)+'</div>'+
   '<div class="card"><h3>Tipos de caso mês a mês</h3>'+hm+'</div>'+
   '<div class="card"><div class="row between"><h3>Casos em aberto ('+ab.length+')</h3><div class="small muted">'+Object.entries(stc).sort((a,b)=>b[1]-a[1]).map(([k,v])=>esc(k)+': <b>'+v+'</b>').join(' · ')+'</div></div>'+
   (ab.length?'<div class="tbl-wrap gr-t"><table><thead><tr><th>Loja</th><th>Tipo</th><th class="v">Abertura</th><th>Status</th></tr></thead><tbody>'+lista+'</tbody></table></div>':'<div class="empty">Nenhum caso em aberto.</div>')+'</div>';
};
views.grow.bind=()=>{ document.querySelectorAll('[data-gwl]').forEach(b=>b.onclick=()=>{ GW.loja=b.dataset.gwl; render(); }); };

function render(){
  const v=(location.hash||'#grupo').slice(1); const V=views[v]?v:'grupo';
  document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('on',a.dataset.v===V));
  $('#mcs').innerHTML=[['','Todas as marcas'],['AC','Citroën'],['AP','Peugeot'],['LP','Leapmotor']].map(([k,l])=>'<button data-mc="'+k+'" class="'+(F.mc===k?'on':'')+'">'+l+'</button>').join('');
  document.querySelectorAll('[data-mc]').forEach(b=>b.onclick=()=>{ F.mc=b.dataset.mc; render(); });
  $('#main').innerHTML=views[V](); views[V].bind&&views[V].bind();
}
addEventListener('hashchange',render); render();
</script></body></html>
