  const kp=LJ.filter(l=>GW.loja==='todas'||GW.loja===l).map(l=>{ const a=ab.filter(c=>c.l===l); const mesAtual=meses[meses.length-1]; const novos=C.filter(c=>c.l===l&&c.ab.slice(0,7)===mesAtual).length;
