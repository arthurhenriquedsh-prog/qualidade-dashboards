function grProgMensal(f,meses){
  const S_=meses.map(m=>f([m])); const labs=[...new Set(S_.flatMap(o=>Object.keys(o.a)))];
  const L=[['n','Pesquisas respondidas','qtd',o=>o.n||null],['nps','NPS','pp',o=>o.nps],['det','Detratores (0–6)','inv',o=>o.n?o.d:null],['sat','Satisfação geral (média)','nota',o=>o.sat],
    ...labs.map(k=>[k,k,'pp',o=>{ const a=o.a[k]; return a&&a[2]?Math.round(a[0]/a[2]*100):null; }]),
    ['of','Respostas ruins a cada 10 pesquisas','inv',o=>{ if(Object.keys(o.a).length<3) return null; const tot=Object.values(o.a).reduce((s,a)=>s+a[1],0); const n=Math.max(0,...Object.values(o.a).map(a=>a[2])); return n?Math.round(tot/n*100)/10:null; }]];
  const fmt=(k,tp,v)=>v==null?null:tp==='pp'?(k==='nps'?pct(v):v+'%'):tp==='nota'?v.toFixed(1).replace('.',','):String(v).replace('.',',');
  return '<div class="tbl-wrap tri"><table><thead><tr><th>Indicador</th>'+meses.map(m=>'<th class="v">'+GR_MES[+m.slice(5)-1]+'</th>').join('')+'</tr></thead><tbody>'+
    L.map(([k,lab,tp,g])=>{ const vals=S_.map(g); return '<tr><td>'+esc(lab)+'</td>'+vals.map((v,i)=>{ const fv=fmt(k,tp,v); if(fv==null) return '<td class="na">–</td>'; let pv=null; for(let j=i-1;j>=0;j--){ if(vals[j]!=null){pv=vals[j];break;} } return '<td class="v"><b>'+fv+'</b>'+(i>0?triDelta(k,tp,pv,v):'')+'</td>'; }).join('')+'</tr>'; }).join('')+
    '</tbody></table></div><p class="small muted" style="margin:6px 0 0">A seta compara com o mês anterior que tem dado. Percentuais = melhor resposta de cada pergunta. As perguntas detalhadas começam em julho.</p>';
}
